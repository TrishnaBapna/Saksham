rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check supports both Firebase Custom Claims (Blaze) and Firestore records (Spark Free Plan)
    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == role) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isCaregiver() {
      return hasRole('caregiver');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'admin') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status in ['verified', 'active'])
      );
    }

    function isDoctorVerified() {
      return isDoctor() && (
        !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status in ['verified', 'active']
      );
    }

    // Caregivers can ONLY access patient Storage objects through an active authorized relationship in Firestore
    function isConnectedCaregiver(patientId) {
      return isCaregiver() &&
        firestore.exists(/databases/(default)/documents/relationships/$(request.auth.uid + '_' + patientId)) &&
        firestore.get(/databases/(default)/documents/relationships/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // Doctors can ONLY access patient Storage objects when verified AND an explicit active assignment exists in doctorAssignments
    function isAssignedDoctor(patientId) {
      return isDoctorVerified() &&
        firestore.exists(/databases/(default)/documents/doctorAssignments/$(request.auth.uid + '_' + patientId)) &&
        firestore.get(/databases/(default)/documents/doctorAssignments/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // User profile pictures
    match /users/{userId}/profile.jpg {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        isConnectedCaregiver(userId) ||
        isAssignedDoctor(userId)
      );
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024 // 5MB max
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Loved Ones family photos and voice notes
    match /patients/{patientId}/lovedOnes/{allPaths=**} {
      allow read: if isAuthenticated() && (isOwner(patientId) || isConnectedCaregiver(patientId));
      allow create, update: if isAuthenticated() && (isOwner(patientId) || isConnectedCaregiver(patientId))
        && request.resource.size < 10 * 1024 * 1024 // 10MB max
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
      allow delete: if isAuthenticated() && (isOwner(patientId) || isConnectedCaregiver(patientId));
    }

    // Room Memory photographs
    match /patients/{patientId}/rooms/{allPaths=**} {
      allow read: if isAuthenticated() && (isOwner(patientId) || isConnectedCaregiver(patientId));
      allow create, update: if isAuthenticated() && (isOwner(patientId) || isConnectedCaregiver(patientId))
        && request.resource.size < 15 * 1024 * 1024 // 15MB max
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && (isOwner(patientId) || isConnectedCaregiver(patientId));
    }

    // Clinical reports (PDFs)
    match /patients/{patientId}/reports/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isOwner(patientId) ||
        isAssignedDoctor(patientId) ||
        isConnectedCaregiver(patientId)
      );
      allow create, update: if isAuthenticated() && isAssignedDoctor(patientId)
        && request.resource.size < 20 * 1024 * 1024 // 20MB max
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('application/pdf'));
      allow delete: if isAuthenticated() && isAssignedDoctor(patientId);
    }

    // Doctor verification credential documents
    match /doctorVerifications/{doctorId}/{allPaths=**} {
      allow read: if isAuthenticated() && (isOwner(doctorId) || isAdmin());
      allow create, update: if isAuthenticated() && isOwner(doctorId)
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType.matches('image/.*')
        );
      allow delete: if isAuthenticated() && isAdmin();
    }
  }
}
