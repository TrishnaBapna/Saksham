rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Role Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check supports both Firebase Custom Claims (Blaze) and Firestore records (Spark Free Plan)
    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['verified', 'active'])
      );
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isCaregiver() {
      return hasRole('caregiver');
    }

    function isPatient() {
      return hasRole('patient');
    }

    // Caregivers can ONLY access patients through an active authorized relationship
    function isConnectedCaregiver(patientId) {
      return isCaregiver() &&
        exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // Granular Caregiver Calendar Permission check
    function hasCaregiverCalendarPerm(patientId, permKey) {
      return isConnectedCaregiver(patientId) &&
        (
          (permKey in get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data &&
           get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data[permKey] == true) ||
          ('permissions' in get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data &&
           permKey in get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data.permissions &&
           get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data.permissions[permKey] == true)
        );
    }

    // Doctors can ONLY access patients when an explicit active assignment exists in doctorAssignments
    function isAssignedDoctor(patientId) {
      return isDoctor() &&
        exists(/databases/$(database)/documents/doctorAssignments/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/doctorAssignments/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // --- 1. Users Collection Security ---
    match /users/{userId} {
      // Users can read their own profile, assigned doctors, connected caregivers, or admins
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        isAssignedDoctor(userId) ||
        isConnectedCaregiver(userId)
      );

      // CREATION SECURITY:
      // 1. User can only create their own profile document (uid matches)
      // 2. Never permit public creation of an administrator account
      // 3. Permitted roles on registration: 'patient', 'caregiver', 'doctor'
      // 4. Initial status for 'doctor' MUST be 'pending' (verification required)
      // 5. Initial status for 'patient' or 'caregiver' can be 'verified'
      // 6. Only pre-approved fields can be written
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role in ['patient', 'caregiver', 'doctor'] &&
        request.resource.data.role != 'admin' &&
        (
          (request.resource.data.role == 'doctor' && request.resource.data.status == 'pending') ||
          (request.resource.data.role in ['patient', 'caregiver'] && request.resource.data.status in ['verified', 'pending'])
        ) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'status', 'phoneNumber',
          'photoURL', 'licenseNumber', 'specialty', 'hospital', 'invitationCode', 'createdAt'
        ]);

      // UPDATE SECURITY:
      // Users can update their basic profile, but CANNOT modify privileged fields:
      // role, isVerified, status, licenseNumber, verificationStatus, uid
      // Administrators CAN update status (e.g. approving a doctor) and role
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isVerified', 'status', 'licenseNumber', 'verificationStatus', 'uid'
        ])
      ) || isAdmin();

      allow delete: if isAdmin();

      // 1b. Adaptive Difficulty Profiles (Strictly Private Patient Engagement State)
      // Only the authenticated patient (owner) can read, create, update, or delete their profile.
      // Caregivers and doctors do NOT receive access automatically; administrators do NOT receive access.
      match /adaptiveProfiles/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.patientId == userId &&
          request.resource.data.currentDifficulty in ['Gentle', 'Moderate', 'Stimulating'] &&
          request.resource.data.pacing in ['calm', 'balanced', 'agile'] &&
          (!('syncStatus' in request.resource.data) || request.resource.data.syncStatus in ['local-only', 'offline-pending', 'syncing', 'synced', 'sync-failed']) &&
          request.resource.data.keys().hasOnly([
            'patientId', 'currentDifficulty', 'pacing',
            'consecutiveComfortableSessions', 'consecutiveStruggleSessions',
            'lastSessionEvaluated', 'lastEvaluatedSessionId', 'evaluatedSessionIds',
            'syncStatus', 'adaptationRationale', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      // 1c. Patient Notes Subcollection (Strictly Private to Patient Owner)
      // Notes are strictly personal and confidential to the patient.
      // Neither caregivers, doctors, nor administrators have access.
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.patientId == userId &&
          request.resource.data.category in ['personal', 'medical', 'family', 'reminder', 'other'] &&
          (!('syncStatus' in request.resource.data) || request.resource.data.syncStatus in ['local-only', 'offline-pending', 'syncing', 'synced', 'sync-error', 'sync-paused']) &&
          request.resource.data.keys().hasOnly([
            'id', 'patientId', 'title', 'content', 'category', 'isPinned',
            'tags', 'voiceMetadata', 'syncStatus', 'createdAt', 'updatedAt', 'deletedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      // 1d. Calendar Events Subcollection
      // Owner (patient) has full CRUD on all events.
      // Authorized connected caregivers can access based on granular permissions in their relationship doc.
      // Private events (isPrivate == true) are strictly confidential to the patient and cannot be read, updated, or deleted by caregivers.
      // Caregivers cannot create private events or mutate the isPrivate flag.
      match /calendarEvents/{eventId} {
        allow read: if isOwner(userId) || (
          hasCaregiverCalendarPerm(userId, 'canReadCalendar') &&
          resource.data.isPrivate != true
        );
        allow create: if isOwner(userId) || (
          hasCaregiverCalendarPerm(userId, 'canCreateCalendarEvents') &&
          request.resource.data.patientId == userId &&
          request.resource.data.isPrivate != true
        );
        allow update: if isOwner(userId) || (
          hasCaregiverCalendarPerm(userId, 'canEditCalendarEvents') &&
          resource.data.isPrivate != true &&
          request.resource.data.isPrivate != true &&
          request.resource.data.patientId == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPrivate']) || request.resource.data.isPrivate == resource.data.isPrivate)
        );
        allow delete: if isOwner(userId) || (
          hasCaregiverCalendarPerm(userId, 'canDeleteCalendarEvents') &&
          resource.data.isPrivate != true
        );
      }

      // 1e. Adaptive Care Proposals Subcollection (Stage 3 Phase B & C)
      // Audit-preserved proposals for personalized cognitive support and routine scaffolding.
      // - Unrelated accounts CANNOT read or update.
      // - Caregivers CANNOT approve clinician-prescribed tasks (isClinicianPrescribed == true).
      // - Audit history fields (id, patientId, activityId, createdAt, domain, isClinicianPrescribed) cannot be overwritten.
      // - Deletion is strictly prohibited to guarantee immutable audit retention.
      match /adaptiveProposals/{proposalId} {
        allow read: if isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId);
        allow create: if (isOwner(userId) || isConnectedCaregiver(userId)) &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == proposalId;
        allow update: if (isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId)) &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.activityId == resource.data.activityId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.domain == resource.data.domain &&
          request.resource.data.isClinicianPrescribed == resource.data.isClinicianPrescribed &&
          request.resource.data.status in ['recommendation_generated', 'awaiting_approval', 'accepted', 'approved', 'active', 'activated', 'declined', 'reverted'] &&
          !(isCaregiver() && resource.data.isClinicianPrescribed == true && request.resource.data.status in ['approved', 'activated']);
        allow delete: if false; // Proposals are preserved as immutable audit trail
      }

      // 1f. In-App Notifications Subcollection (Stage 3 Phase C)
      // Privacy-first notification records. Accessible only to owner, connected caregiver, or assigned doctor.
      // Overwriting notification types or transferring notifications across patients is forbidden.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId);
        allow create: if (isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId)) &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == notificationId;
        allow update: if (isOwner(userId) || isConnectedCaregiver(userId)) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.type == resource.data.type;
        allow delete: if false; // Audit retention
      }

      // 1g. Longitudinal Clinical Reports Subcollection (Stage 3 Phase D)
      // Clinician and family consultation briefs.
      // - Accessible strictly to owner (patient), connected caregiver, or assigned doctor.
      // - Unrelated accounts strictly denied.
      // - Deletion prohibited for audit retention.
      match /longitudinalReports/{reportId} {
        allow read: if isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId);
        allow create: if (isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId)) &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == reportId;
        allow update: if (isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId)) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.id == resource.data.id;
        allow delete: if false; // Immutable clinical audit retention
      }

      // 1h. Caregiver Observation Notes Subcollection (Stage 3 Phase D)
      // Confidential functional observations recorded by caregivers or patients.
      // - Accessible strictly to owner (patient), connected caregiver, or assigned doctor.
      // - Unrelated accounts strictly denied.
      match /caregiverNotes/{noteId} {
        allow read: if isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId);
        allow create: if (isOwner(userId) || isConnectedCaregiver(userId)) &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == noteId;
        allow update: if (isOwner(userId) || isConnectedCaregiver(userId)) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) || isConnectedCaregiver(userId);
      }

      // 1i. Cognitive Concerns Subcollection (Stage 3 Phase F)
      // Patient and caregiver observations of everyday cognitive and functional changes.
      // - Patient and connected caregiver have read permissions.
      // - Assigned doctor may ONLY read if resource.data.sharedWithDoctor == true (Product Owner Decision 3).
      // - Doctors CANNOT create or update cognitive concerns (!isDoctor()).
      // - Creation requires matching perspective and recordedBy == request.auth.uid.
      // - Updates cannot mutate provenance fields (id, patientId, recordedBy, perspective, recordedAt, category).
      // - Consent Ownership: Only patient owner can modify sharedWithDoctor on patient-perspective concerns.
      // - Deletion permitted only to patient owner or the original recording caregiver.
      match /cognitiveConcerns/{concernId} {
        allow read: if isOwner(userId) || isConnectedCaregiver(userId) ||
          (isAssignedDoctor(userId) && ('sharedWithDoctor' in resource.data) && resource.data.sharedWithDoctor == true);
        allow create: if !isDoctor() &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == concernId &&
          request.resource.data.recordedBy == request.auth.uid &&
          (
            (isOwner(userId) && request.resource.data.perspective == 'patient') ||
            (isConnectedCaregiver(userId) && request.resource.data.perspective == 'caregiver')
          ) &&
          request.resource.data.keys().hasAll([
            'id', 'patientId', 'recordedBy', 'perspective', 'category', 'description', 'recordedAt', 'sharedWithDoctor'
          ]);
        allow update: if (isOwner(userId) || isConnectedCaregiver(userId)) &&
          !isDoctor() &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.recordedBy == resource.data.recordedBy &&
          request.resource.data.perspective == resource.data.perspective &&
          request.resource.data.recordedAt == resource.data.recordedAt &&
          request.resource.data.category == resource.data.category &&
          (
            resource.data.perspective != 'patient' ||
            isOwner(userId) ||
            request.resource.data.sharedWithDoctor == resource.data.sharedWithDoctor
          ) &&
          (
            resource.data.perspective != 'caregiver' ||
            isOwner(userId) ||
            resource.data.recordedBy == request.auth.uid ||
            request.resource.data.sharedWithDoctor == resource.data.sharedWithDoctor
          );
        allow delete: if isOwner(userId) ||
          (isConnectedCaregiver(userId) && resource.data.recordedBy == request.auth.uid);
      }

      // 1j. Clinical Assessment Records Subcollection (Stage 3 Phase F)
      // Formal external assessments (MMSE, MoCA, HMSE, CDR, etc.) recorded by authorized doctors.
      // - Strictly clinician-created (isAssignedDoctor(userId)) (Product Owner Decision 2).
      // - Patient, connected caregiver, and assigned doctor can read.
      // - Provenance immutability: doctorId, patientId, assessmentName, recordedAt, administrationDate cannot change.
      // - Updates require amendment log appending; direct updates without amendments are rejected.
      // - Immutable audit log: delete is strictly disallowed.
      match /clinicalAssessments/{assessmentId} {
        allow read: if isOwner(userId) || isConnectedCaregiver(userId) || isAssignedDoctor(userId);
        allow create: if isAssignedDoctor(userId) &&
          request.resource.data.patientId == userId &&
          request.resource.data.id == assessmentId &&
          request.resource.data.doctorId == request.auth.uid &&
          request.resource.data.administeredExternally == true &&
          request.resource.data.keys().hasAll([
            'id', 'patientId', 'doctorId', 'assessmentName', 'administrationDate', 'administeredExternally', 'recordedAt'
          ]);
        allow update: if isAssignedDoctor(userId) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.assessmentName == resource.data.assessmentName &&
          request.resource.data.administeredExternally == resource.data.administeredExternally &&
          request.resource.data.recordedAt == resource.data.recordedAt &&
          request.resource.data.administrationDate == resource.data.administrationDate &&
          ('amendments' in request.resource.data) &&
          (request.resource.data.amendments is list) &&
          request.resource.data.amendments.size() > (('amendments' in resource.data) ? resource.data.amendments.size() : 0);
        allow delete: if false; // Immutable clinical assessment audit trail
      }
    }

    // --- 2. Patients Medical Profile & Clinician-Confirmed Diagnosis ---
    // Confidential medical profile: Accessible ONLY to patient, connected caregiver, or assigned doctor
    // Administrators do NOT receive unrestricted clinical-record access by default
    match /patients/{patientId} {
      allow read: if isOwner(patientId) || isConnectedCaregiver(patientId) || isAssignedDoctor(patientId);
      // Patients and caregivers can update non-clinical profile attributes (e.g. displayName, phone, preferences),
      // but CANNOT modify protected clinical diagnosis fields directly in root document.
      allow create: if isOwner(patientId);
      allow update: if (isOwner(patientId) || isConnectedCaregiver(patientId))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'clinicalDiagnosis', 'pathway', 'diagnosisEtiology', 'clinicalStage', 'confirmedByDoctorId'
        ]));
      allow delete: if false;

      // Subcollection: Clinical Diagnosis Records
      // STRICTLY WRITABLE BY ASSIGNED DOCTOR ONLY
      // Patients and caregivers have READ-ONLY access to confirmed diagnosis.
      match /clinicalDiagnosis/{diagnosisId} {
        allow read: if isOwner(patientId) || isConnectedCaregiver(patientId) || isAssignedDoctor(patientId);
        allow create: if isAuthenticated()
          && isAssignedDoctor(patientId)
          && request.resource.data.confirmedByDoctorId == request.auth.uid
          && request.resource.data.patientId == patientId
          && request.resource.data.isCurrent == true;
        allow update: if isAuthenticated()
          && isAssignedDoctor(patientId)
          && request.resource.data.confirmedByDoctorId == request.auth.uid
          && request.resource.data.patientId == patientId;
        allow delete: if false; // Immutable medical diagnosis audit trail
      }

      // Subcollection: Clinical Prescription Records
      // STRICTLY WRITABLE BY ASSIGNED DOCTOR ONLY
      // Patients and caregivers have READ-ONLY access.
      // Updates require appending to immutable amendments audit trail.
      // Deletion is strictly prohibited.
      match /prescriptions/{prescriptionId} {
        allow read: if isOwner(patientId) || isConnectedCaregiver(patientId) || isAssignedDoctor(patientId);
        allow create: if isAuthenticated()
          && isAssignedDoctor(patientId)
          && request.resource.data.prescribedByDoctorId == request.auth.uid
          && request.resource.data.patientId == patientId
          && request.resource.data.isCurrent == true;
        allow update: if isAuthenticated()
          && isAssignedDoctor(patientId)
          && request.resource.data.prescribedByDoctorId == resource.data.prescribedByDoctorId
          && request.resource.data.patientId == patientId
          && ('amendments' in request.resource.data)
          && (request.resource.data.amendments is list)
          && request.resource.data.amendments.size() > (('amendments' in resource.data) ? resource.data.amendments.size() : 0);
        allow delete: if false; // Immutable prescription audit trail
      }
    }

    // --- 3. Routines & Schedules ---
    match /routines/{routineId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isAssignedDoctor(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId) ||
        isAssignedDoctor(request.resource.data.patientId)
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      ) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- 3b. Routine Attempt Records ---
    match /routineAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isAssignedDoctor(resource.data.patientId)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if false; // Append-only audit record
    }

    // --- 4. Loved Ones Photo & Audio Memory Cues ---
    // Private family memory cues: restricted strictly to patient and connected caregiver
    match /lovedOnes/{lovedOneId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId)
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      ) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- 5. Room Memory Game Records ---
    // Private home photographs & object hints: restricted to patient and connected caregiver
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );

      match /objects/{objectId} {
        allow read, write: if isAuthenticated() && (
          isOwner(resource.data.patientId) ||
          isConnectedCaregiver(resource.data.patientId)
        );
      }
    }

    // --- 6. Cognitive Game Sessions ---
    match /gameSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isAssignedDoctor(resource.data.patientId)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if false; // Append-only
    }

    // --- 7. Relationships (Caregiver <-> Patient) ---
    match /relationships/{relationshipId} {
      // 1. Read: Only the connected patient, the caregiver, or an administrator
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.caregiverId ||
        isAdmin()
      );

      // 2. Create:
      // - Caregivers CANNOT create pre-approved ('active') relationships with arbitrary patients!
      // - Caregiver-initiated link requests MUST have status == 'pending'
      // - Patient-initiated invitations can be created with status 'pending' or 'active'
      // - Document ID must strictly match $(caregiverId)_$(patientId)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == request.resource.data.caregiverId &&
          request.resource.data.status == 'pending' &&
          relationshipId == request.resource.data.caregiverId + '_' + request.resource.data.patientId &&
          request.resource.data.keys().hasOnly(['caregiverId', 'patientId', 'status', 'createdAt', 'relationshipType', 'permissions'])
        ) ||
        (
          request.auth.uid == request.resource.data.patientId &&
          request.resource.data.status in ['pending', 'active'] &&
          relationshipId == request.resource.data.caregiverId + '_' + request.resource.data.patientId &&
          request.resource.data.keys().hasOnly(['caregiverId', 'patientId', 'status', 'createdAt', 'relationshipType', 'permissions'])
        )
      );

      // 3. Update:
      // - Caregivers CANNOT approve their own relationship (CANNOT set status to 'active')!
      // - Caregivers can only cancel/revoke or modify permissions (status in ['pending', 'cancelled', 'revoked'])
      // - Patients CAN approve ('active') or revoke ('revoked', 'rejected') relationships
      // - caregiverId and patientId are strictly immutable
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == resource.data.patientId &&
          request.resource.data.caregiverId == resource.data.caregiverId &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.status in ['active', 'revoked', 'rejected', 'pending']
        ) ||
        (
          request.auth.uid == resource.data.caregiverId &&
          request.resource.data.caregiverId == resource.data.caregiverId &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.status in ['pending', 'cancelled', 'revoked'] &&
          request.resource.data.status != 'active'
        )
      );

      // 4. Delete: Either patient, caregiver, or administrator can terminate access
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.caregiverId ||
        isAdmin()
      );
    }

    // --- 8. Doctor Clinical Assignments ---
    match /doctorAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.doctorId ||
        request.auth.uid == resource.data.patientId ||
        isAdmin()
      );
      // Strictly administrators can create, update, or revoke doctor assignments
      allow create: if isAdmin() &&
        assignmentId == request.resource.data.doctorId + '_' + request.resource.data.patientId &&
        request.resource.data.keys().hasOnly(['doctorId', 'patientId', 'status', 'assignedAt', 'notes']);
      allow update: if isAdmin() &&
        request.resource.data.doctorId == resource.data.doctorId &&
        request.resource.data.patientId == resource.data.patientId;
      allow delete: if isAdmin();
    }

    // --- 9. Location Updates (Consent-governed) ---
    match /locationUpdates/{updateId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        (isConnectedCaregiver(resource.data.patientId) && resource.data.isSharedWithCaregiver == true)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if isOwner(resource.data.patientId);
    }

    // --- 10. Geofences ---
    match /geofences/{geofenceId} {
      allow read, write: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- 11. Feedback ---
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // --- 12. Audit Logs (System-managed only) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
