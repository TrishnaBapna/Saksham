rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Role Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check supports both Firebase Custom Claims (Blaze) and Firestore records (Spark Free Plan)
    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['verified', 'active'])
      );
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isCaregiver() {
      return hasRole('caregiver');
    }

    function isPatient() {
      return hasRole('patient');
    }

    // Caregivers can ONLY access patients through an active authorized relationship
    function isConnectedCaregiver(patientId) {
      return isCaregiver() &&
        exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // Doctors can ONLY access patients when an explicit active assignment exists in doctorAssignments
    function isAssignedDoctor(patientId) {
      return isDoctor() &&
        exists(/databases/$(database)/documents/doctorAssignments/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/doctorAssignments/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // --- 1. Users Collection Security ---
    match /users/{userId} {
      // Users can read their own profile, assigned doctors, connected caregivers, or admins
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        isAssignedDoctor(userId) ||
        isConnectedCaregiver(userId)
      );

      // CREATION SECURITY:
      // 1. User can only create their own profile document (uid matches)
      // 2. Never permit public creation of an administrator account
      // 3. Permitted roles on registration: 'patient', 'caregiver', 'doctor'
      // 4. Initial status for 'doctor' MUST be 'pending' (verification required)
      // 5. Initial status for 'patient' or 'caregiver' can be 'verified'
      // 6. Only pre-approved fields can be written
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role in ['patient', 'caregiver', 'doctor'] &&
        request.resource.data.role != 'admin' &&
        (
          (request.resource.data.role == 'doctor' && request.resource.data.status == 'pending') ||
          (request.resource.data.role in ['patient', 'caregiver'] && request.resource.data.status in ['verified', 'pending'])
        ) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'status', 'phoneNumber',
          'photoURL', 'licenseNumber', 'specialty', 'hospital', 'invitationCode', 'createdAt'
        ]);

      // UPDATE SECURITY:
      // Users can update their basic profile, but CANNOT modify privileged fields:
      // role, isVerified, status, licenseNumber, verificationStatus, uid
      // Administrators CAN update status (e.g. approving a doctor) and role
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isVerified', 'status', 'licenseNumber', 'verificationStatus', 'uid'
        ])
      ) || isAdmin();

      allow delete: if isAdmin();

      // 1b. Adaptive Difficulty Profiles (Strictly Private Patient Engagement State)
      // Only the authenticated patient (owner) can read, create, update, or delete their profile.
      // Caregivers and doctors do NOT receive access automatically; administrators do NOT receive access.
      match /adaptiveProfiles/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.patientId == userId &&
          request.resource.data.currentDifficulty in ['Gentle', 'Moderate', 'Stimulating'] &&
          request.resource.data.pacing in ['calm', 'balanced', 'agile'] &&
          (!('syncStatus' in request.resource.data) || request.resource.data.syncStatus in ['local-only', 'offline-pending', 'syncing', 'synced', 'sync-failed']) &&
          request.resource.data.keys().hasOnly([
            'patientId', 'currentDifficulty', 'pacing',
            'consecutiveComfortableSessions', 'consecutiveStruggleSessions',
            'lastSessionEvaluated', 'lastEvaluatedSessionId', 'evaluatedSessionIds',
            'syncStatus', 'adaptationRationale', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }
    }

    // --- 2. Patients Medical Profile ---
    // Confidential medical profile: Accessible ONLY to patient, connected caregiver, or assigned doctor
    // Administrators do NOT receive unrestricted clinical-record access by default
    match /patients/{patientId} {
      allow read: if isOwner(patientId) || isConnectedCaregiver(patientId) || isAssignedDoctor(patientId);
      allow write: if isOwner(patientId) || isConnectedCaregiver(patientId);
    }

    // --- 3. Routines & Schedules ---
    match /routines/{routineId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isAssignedDoctor(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId) ||
        isAssignedDoctor(request.resource.data.patientId)
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      ) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- 3b. Routine Attempt Records ---
    match /routineAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isAssignedDoctor(resource.data.patientId)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if false; // Append-only audit record
    }

    // --- 4. Loved Ones Photo & Audio Memory Cues ---
    // Private family memory cues: restricted strictly to patient and connected caregiver
    match /lovedOnes/{lovedOneId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId)
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      ) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- 5. Room Memory Game Records ---
    // Private home photographs & object hints: restricted to patient and connected caregiver
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );

      match /objects/{objectId} {
        allow read, write: if isAuthenticated() && (
          isOwner(resource.data.patientId) ||
          isConnectedCaregiver(resource.data.patientId)
        );
      }
    }

    // --- 6. Cognitive Game Sessions ---
    match /gameSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isAssignedDoctor(resource.data.patientId)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if false; // Append-only
    }

    // --- 7. Relationships (Caregiver <-> Patient) ---
    match /relationships/{relationshipId} {
      // 1. Read: Only the connected patient, the caregiver, or an administrator
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.caregiverId ||
        isAdmin()
      );

      // 2. Create:
      // - Caregivers CANNOT create pre-approved ('active') relationships with arbitrary patients!
      // - Caregiver-initiated link requests MUST have status == 'pending'
      // - Patient-initiated invitations can be created with status 'pending' or 'active'
      // - Document ID must strictly match $(caregiverId)_$(patientId)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == request.resource.data.caregiverId &&
          request.resource.data.status == 'pending' &&
          relationshipId == request.resource.data.caregiverId + '_' + request.resource.data.patientId &&
          request.resource.data.keys().hasOnly(['caregiverId', 'patientId', 'status', 'createdAt', 'relationshipType', 'permissions'])
        ) ||
        (
          request.auth.uid == request.resource.data.patientId &&
          request.resource.data.status in ['pending', 'active'] &&
          relationshipId == request.resource.data.caregiverId + '_' + request.resource.data.patientId &&
          request.resource.data.keys().hasOnly(['caregiverId', 'patientId', 'status', 'createdAt', 'relationshipType', 'permissions'])
        )
      );

      // 3. Update:
      // - Caregivers CANNOT approve their own relationship (CANNOT set status to 'active')!
      // - Caregivers can only cancel/revoke or modify permissions (status in ['pending', 'cancelled', 'revoked'])
      // - Patients CAN approve ('active') or revoke ('revoked', 'rejected') relationships
      // - caregiverId and patientId are strictly immutable
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == resource.data.patientId &&
          request.resource.data.caregiverId == resource.data.caregiverId &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.status in ['active', 'revoked', 'rejected', 'pending']
        ) ||
        (
          request.auth.uid == resource.data.caregiverId &&
          request.resource.data.caregiverId == resource.data.caregiverId &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.status in ['pending', 'cancelled', 'revoked'] &&
          request.resource.data.status != 'active'
        )
      );

      // 4. Delete: Either patient, caregiver, or administrator can terminate access
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.caregiverId ||
        isAdmin()
      );
    }

    // --- 8. Doctor Clinical Assignments ---
    match /doctorAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.doctorId ||
        request.auth.uid == resource.data.patientId ||
        isAdmin()
      );
      // Strictly administrators can create, update, or revoke doctor assignments
      allow create: if isAdmin() &&
        assignmentId == request.resource.data.doctorId + '_' + request.resource.data.patientId &&
        request.resource.data.keys().hasOnly(['doctorId', 'patientId', 'status', 'assignedAt', 'notes']);
      allow update: if isAdmin() &&
        request.resource.data.doctorId == resource.data.doctorId &&
        request.resource.data.patientId == resource.data.patientId;
      allow delete: if isAdmin();
    }

    // --- 9. Location Updates (Consent-governed) ---
    match /locationUpdates/{updateId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        (isConnectedCaregiver(resource.data.patientId) && resource.data.isSharedWithCaregiver == true)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if isOwner(resource.data.patientId);
    }

    // --- 10. Geofences ---
    match /geofences/{geofenceId} {
      allow read, write: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- 11. Feedback ---
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // --- 12. Audit Logs (System-managed only) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
