rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isCaregiver() {
      return hasRole('caregiver');
    }

    function isPatient() {
      return hasRole('patient');
    }

    function isConnectedCaregiver(patientId) {
      return isCaregiver() &&
        exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/relationships/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isDoctor() || isConnectedCaregiver(userId));
      // Users can update their basic profile but CANNOT modify their role or verification status
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified']);
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // --- Patients Profile ---
    match /patients/{patientId} {
      allow read: if isOwner(patientId) || isConnectedCaregiver(patientId) || isDoctor() || isAdmin();
      allow write: if isOwner(patientId) || isConnectedCaregiver(patientId) || isAdmin();
    }

    // --- Routines & Schedules ---
    match /routines/{routineId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isDoctor()
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId) ||
        isDoctor()
      );
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- Loved Ones Photo & Audio Memory Cues ---
    match /lovedOnes/{lovedOneId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId)
      );
    }

    // --- Room Memory Game Records ---
    match /rooms/{roomId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        isOwner(request.resource.data.patientId) ||
        isConnectedCaregiver(request.resource.data.patientId)
      );

      match /objects/{objectId} {
        allow read, write: if isAuthenticated() && (
          isOwner(resource.data.patientId) ||
          isConnectedCaregiver(resource.data.patientId)
        );
      }
    }

    // --- Cognitive Game Sessions ---
    match /gameSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId) ||
        isDoctor()
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if false; // Game history is append-only
    }

    // --- Relationships (Caregiver <-> Patient) ---
    match /relationships/{relationshipId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.caregiverId ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.patientId ||
        request.auth.uid == request.resource.data.caregiverId ||
        isAdmin()
      );
    }

    // --- Location Updates (Consent-governed) ---
    match /locationUpdates/{updateId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        (isConnectedCaregiver(resource.data.patientId) && resource.data.isSharedWithCaregiver == true)
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.patientId);
      allow update, delete: if isOwner(resource.data.patientId);
    }

    // --- Geofences ---
    match /geofences/{geofenceId} {
      allow read, write: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isConnectedCaregiver(resource.data.patientId)
      );
    }

    // --- Feedback ---
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Audit Logs (System-managed only) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Writes must occur through Cloud Functions using Admin SDK
    }
  }
}
