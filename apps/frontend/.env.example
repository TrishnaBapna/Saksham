# Required environment variables for Saksham 2.0 frontend
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Firebase (required) ──────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=saksham-2b5f0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=saksham-2b5f0
VITE_FIREBASE_STORAGE_BUCKET=saksham-2b5f0.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Backend API (optional — only needed if running apps/backend locally) ──────
VITE_API_BASE_URL=/api

# ── Feature flags (optional — all default to true) ───────────────────────────
VITE_FEATURE_WEBAUTHN=true
VITE_FEATURE_VOICE=true
VITE_FEATURE_FACE=true
