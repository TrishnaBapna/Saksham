# Environment Variables Configuration
# Copy this file to .env or .env.local and fill in your actual credentials.

# Database: PostgreSQL (or fallback SQLite for zero-config local run)
DATABASE_URL="file:./dev.db"

# Admin Dashboard Access
ADMIN_PASSWORD="trishna-admin-secure-2026"
ADMIN_SESSION_SECRET="trishna-session-super-secret-key-32chars-min"

# GitHub API (Optional: provides higher rate limits for fetching repos)
GITHUB_ACCESS_TOKEN=""

# AI Portfolio Assistant (Supports OpenAI or Gemini or local intelligent fallback)
AI_API_KEY=""
AI_PROVIDER="local-fallback" # options: "openai", "gemini", "local-fallback"

# Contact Notifications (e.g. Resend, Sendgrid, or SMTP)
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL="trishnabapna@example.com"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional YouTube API Key
YOUTUBE_API_KEY=""
