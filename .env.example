# =======================================================================
# SAKSHAM ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================================

# -----------------------------------------------------------------------
# Supabase PostgreSQL Database (Recommended Cloud Database)
# Create a free project at https://supabase.com
# -----------------------------------------------------------------------
# Your project URL (Settings > API > Project URL)
SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Your public Anon Key (Settings > API > Project API keys > anon public)
# Safe to expose to the client browser with Row Level Security enabled
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Keep secret! Only for backend migration scripts)
SUPABASE_SERVICE_ROLE_KEY=""

# Direct PostgreSQL Connection String (Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# -----------------------------------------------------------------------
# Artificial Intelligence Services (Google Gemini 1.5)
# -----------------------------------------------------------------------
GEMINI_API_KEY=""
AI_API_KEY=""
AI_PROVIDER="gemini"

# -----------------------------------------------------------------------
# Application Metadata & Deployment
# -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://saksham-rho-six.vercel.app"
PORT=3000
