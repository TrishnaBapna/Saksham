rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if request is by document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Root Profile: users/{userId}
    match /users/{userId} {
      // Authenticated owner can read their own profile
      // Unauthenticated users cannot read profiles
      allow read: if isOwner(userId);

      // User can create and update their non-privileged profile data
      allow create: if isOwner(userId) && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId);

      // Account deletion
      allow delete: if isOwner(userId);

      // 2. Sensitive Biometric Subcollection: users/{userId}/faceProfile/{profileId}
      // - STRICTLY DENY unauthenticated access
      // - STRICTLY DENY other users from accessing another user's face representation
      // - Only the authenticated owner can access their faceProfile document
      match /faceProfile/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) 
          && request.resource.data.protectedEmbedding is string
          && request.resource.data.protectedEmbedding.size() > 20;
        allow delete: if isOwner(userId);
      }

      // 3. WebAuthn Passkeys Subcollection: users/{userId}/passkeys/{credentialId}
      // - Only the authenticated owner can read or write passkey metadata
      // - Raw private keys never exist here; only public key credentials
      match /passkeys/{credentialId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.credentialId is string;
        allow delete: if isOwner(userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
