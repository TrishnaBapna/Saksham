rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Core Helper Functions ────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reject obviously fake / demo UIDs (must look like a real Firebase UID or email-based UID)
    function isRealUid(userId) {
      // Firebase UIDs are 28 chars, alphanumeric. Demo UIDs like 'SAK-PT-8842' are rejected.
      return userId.size() >= 20 || userId.matches('.*@.*');
    }

    function isAuthorizedCaregiver(patientId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(patientId)/caregivers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(patientId)/care_team/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(patientId)/care_team/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isCareTeamRole(patientId, expectedRole) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(patientId)/care_team/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(patientId)/care_team/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(patientId)/care_team/$(request.auth.uid)).data.role == expectedRole;
    }

    // ─── Root User Profiles ───────────────────────────────────────────────
    match /users/{userId} {
      // A user can create their own profile document on first sign-up
      allow create: if isOwner(userId) && isRealUid(userId);
      // A user can read and update their own profile
      allow read, update, delete: if isOwner(userId);
      // Authorized caregivers can read patient profile (read-only)
      allow read: if isAuthorizedCaregiver(userId);

      // ── Caregiver Authorization Subcollection ─────────────────────────
      // /users/{userId}/caregivers/{caregiverId}
      match /caregivers/{caregiverId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthenticated() && request.auth.uid == caregiverId;
      }

      match /care_team_requests/{memberId} {
        allow create: if isAuthenticated() && request.auth.uid == memberId &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.patientUid == userId &&
          request.resource.data.role in ['caregiver', 'doctor'] &&
          request.resource.data.status == 'pending';
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == memberId);
        allow update: if isOwner(userId) && resource.data.status == 'pending' &&
          request.resource.data.status in ['active', 'rejected'];
        allow delete: if isOwner(userId);
      }

      match /care_team/{memberId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == memberId);
        allow create, update, delete: if isOwner(userId);
      }

      match /linked_patients/{patientId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == patientId);
        allow create, update: if isAuthenticated() && request.auth.uid == patientId &&
          getAfter(/databases/$(database)/documents/users/$(patientId)/care_team/$(userId)).data.status == 'active';
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == patientId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId) || isAuthorizedCaregiver(userId);
        allow create, update, delete: if isOwner(userId) || isCareTeamRole(userId, 'caregiver');
      }

      match /clinical_notes/{noteId} {
        allow read: if isOwner(userId) || isAuthorizedCaregiver(userId);
        allow create, update, delete: if isOwner(userId) || isCareTeamRole(userId, 'caregiver');
      }

      match /doctor_directives/{directiveId} {
        allow read: if isOwner(userId) || isAuthorizedCaregiver(userId);
        allow create, update, delete: if isOwner(userId) || isCareTeamRole(userId, 'doctor');
      }

      match /telemetry/{recordId} {
        allow read: if isOwner(userId) || isAuthorizedCaregiver(userId);
        allow write: if isOwner(userId);
      }

      match /caregiver_alerts/{alertId} {
        allow read: if isOwner(userId) || isAuthorizedCaregiver(userId);
        allow create, update, delete: if isOwner(userId) || isCareTeamRole(userId, 'caregiver');
      }

      match /progression/{recordId} {
        allow read: if isOwner(userId) || isAuthorizedCaregiver(userId);
        allow write: if isOwner(userId);
      }

      // ── Safety Profile ────────────────────────────────────────────────
      match /safety/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      // ── Location / SafePath ───────────────────────────────────────────
      match /locations/{locationId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      match /location/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      // ── SOS Alerts Subcollection ──────────────────────────────────────
      match /sosAlerts/{alertId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      // ── Onboarding Data ───────────────────────────────────────────────
      match /onboarding/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── All Other Subcollections ──────────────────────────────────────
      // (tasks, loved_ones, telemetry, clinical_notes, doctor_directives,
      //  caregiver_alerts, progression, biometrics)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }
    }

    // ─── Top-level SOS Events ─────────────────────────────────────────────
    match /sosEvents/{sosId} {
      // Patient creates SOS event with their own UID
      allow create: if isAuthenticated()
        && request.resource.data.patientId == request.auth.uid;

      // Patient and authorized caregivers can read emergency alerts
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isAuthorizedCaregiver(resource.data.patientId)
      );

      // Patient or authorized caregiver can update/resolve active SOS
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isAuthorizedCaregiver(resource.data.patientId)
      );
    }
  }
}
