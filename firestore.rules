rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Core Helper Functions ────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reject obviously fake / demo UIDs (must look like a real Firebase UID or email-based UID)
    function isRealUid(userId) {
      // Firebase UIDs are 28 chars, alphanumeric. Demo UIDs like 'SAK-PT-8842' are rejected.
      return userId.size() >= 20 || userId.matches('.*@.*');
    }

    // Check if the requesting user is an authorized caregiver for this patient
    function isAuthorizedCaregiver(patientId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(patientId)/caregivers/$(request.auth.uid))
      );
    }

    // ─── Root User Profiles ───────────────────────────────────────────────
    match /users/{userId} {
      // A user can create their own profile document on first sign-up
      allow create: if isOwner(userId) && isRealUid(userId);
      // A user can read and update their own profile
      allow read, update, delete: if isOwner(userId);
      // Authorized caregivers can read patient profile (read-only)
      allow read: if isAuthorizedCaregiver(userId);

      // ── Caregiver Authorization Subcollection ─────────────────────────
      // /users/{userId}/caregivers/{caregiverId}
      match /caregivers/{caregiverId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthenticated() && request.auth.uid == caregiverId;
      }

      // ── Safety Profile ────────────────────────────────────────────────
      match /safety/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      // ── Location / SafePath ───────────────────────────────────────────
      match /locations/{locationId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      match /location/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      // ── SOS Alerts Subcollection ──────────────────────────────────────
      match /sosAlerts/{alertId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }

      // ── Onboarding Data ───────────────────────────────────────────────
      match /onboarding/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── All Other Subcollections ──────────────────────────────────────
      // (tasks, loved_ones, telemetry, clinical_notes, doctor_directives,
      //  caregiver_alerts, progression, biometrics)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthorizedCaregiver(userId);
      }
    }

    // ─── Top-level SOS Events ─────────────────────────────────────────────
    match /sosEvents/{sosId} {
      // Patient creates SOS event with their own UID
      allow create: if isAuthenticated()
        && request.resource.data.patientId == request.auth.uid;

      // Patient and authorized caregivers can read emergency alerts
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isAuthorizedCaregiver(resource.data.patientId)
      );

      // Patient or authorized caregiver can update/resolve active SOS
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isAuthorizedCaregiver(resource.data.patientId)
      );
    }
  }
}
